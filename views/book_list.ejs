<!DOCTYPE html>
<!doctype html>
<html>
<head>
    <title>Bertie's Books Shop</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; }
        h1 { color: #0080c9; }
        h2 { color: #0a6fa6; }
        .book-item { margin-bottom: 5px; }
    </style>
</head>
<body>
    <h1>Bertie's Books Shop</h1>
    <h2>Here are the books that we sell:</h2>
    
    <div class="book-list">
        <% if (availableBooks && availableBooks.length > 0) { %>
            <ul>
                <% availableBooks.forEach(function(book) { %>
                    <li><%= book.name %>, £<%= Number(book.price).toFixed(2) %></li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No books found.</p>
        <% } %>
    </div>

    <p><a href="/">Home</a></p>
</body>
</html>