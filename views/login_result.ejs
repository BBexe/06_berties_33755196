<!doctype html>
<html>
<head>
    <title>Login Status</title>
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            padding: 40px; 
            text-align: center; 
            background-color: #f4f4f9; 
        }
        .box { 
            background: white; 
            padding: 30px; 
            border-radius: 8px; 
            box-shadow: 0 0 10px rgba(0,0,0,0.1); 
            display: inline-block; 
            max-width: 400px;
            width: 100%;
        }
        h1 { margin-top: 0; }
        .success { color: #28a745; }
        .error { color: #dc3545; }
        .btn { 
            display: inline-block; 
            text-decoration: none; 
            background-color: #007bff; 
            color: white; 
            padding: 10px 20px; 
            border-radius: 5px; 
            margin-top: 20px; 
        }
        .btn:hover { background-color: #0056b3; }
    </style>
</head>
<body>
    <div class="box">
        <% if (success) { %>
            <h1 class="success">Login Successful!</h1>
            <p>Welcome back, <strong><%= username %></strong>.</p>
            <a href="/" class="btn">Go to Home Page</a>
        <% } else { %>
            <h1 class="error">Login Failed</h1>
            <p><%= message %></p>
            <a href="/users/login" class="btn" style="background-color: #6c757d;">Try Again</a>
        <% } %>
    </div>
</body>
</html>